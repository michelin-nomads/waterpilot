# Web app configuration. PUBLIC values only.
# NEVER put secrets, private keys, tokens or service-account data in VITE_ variables —
# everything prefixed VITE_ is bundled into the browser and is world-readable.

# Local mode: emulators required and the API must be a loopback URL (default below).
# Pilot mode: VITE_USE_EMULATORS=false and an explicit https, non-loopback API URL.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_MODE=local
VITE_USE_EMULATORS=true

# Firebase *public* web config. The API key is a public client identifier, not a secret.
# Only these VITE_ keys are allowed; any other VITE_ variable stops the app at startup.
# Local mode: leave these empty. The app uses the demo-waterpilot project and the Auth
# emulator at 127.0.0.1:9099 (`npm run emulators`); a non-demo project is refused.
# Pilot mode: set the real project's web config and leave the emulator host unset.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_EMULATOR_HOST=

# Google Maps JavaScript + Places (ADR 0009). Pilot only; local mode refuses these and uses
# the API's fixture gazetteer, with no map. The browser key is public by design: restrict
# it in Google Cloud to HTTP referrers (the Hosting domains) and to the Maps JavaScript,
# Places (New) and Geocoding APIs, with daily quotas. Unset in pilot = no map, typed entry.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
