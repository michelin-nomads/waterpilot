{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WaterLens Metric Registry",
  "description": "Machine-readable companion to docs/domain/metrics.md. All definitions are PROPOSED pending domain review. Equations must not be altered to reproduce screenshot example numbers.",
  "version": "0.1",
  "status": "proposed",
  "generatedBy": "Phase 01",
  "conventionsRef": "docs/domain/conventions.md",
  "nullRule": "A missing/unverified input yields status 'unavailable' — never 0 or a fabricated value.",
  "methodTypes": {
    "deterministic": "Computable now from validated inputs by pure engine code.",
    "requires_local_measurement": "Needs in-situ/local data; not inferable from imagery.",
    "requires_reviewed_model": "Needs an explicit, domain-reviewed response relationship."
  },
  "metrics": [
    {
      "id": "demand",
      "name": "Demand",
      "unit": "MLD",
      "storedUnit": "L/day",
      "valueType": "rate",
      "timeWindow": "daily_series_to_window_mean",
      "defaultWindow": "P1Y_half_open",
      "geography": "area_polygon",
      "direction": "neutral",
      "methodType": "requires_local_measurement",
      "formula": "demand_day = population * per_capita_lpcd + non_domestic_demand_day",
      "provenance": [
        "population_source",
        "per_capita_standard_source",
        "non_domestic_estimate_source"
      ],
      "nullSemantics": "unavailable if population or per-capita standard missing",
      "displayRounding": { "type": "decimal_places", "value": 1, "unit": "MLD" },
      "status": "proposed"
    },
    {
      "id": "delivered_supply",
      "name": "Delivered supply",
      "unit": "MLD",
      "storedUnit": "L/day",
      "valueType": "rate",
      "timeWindow": "daily_series_to_window_mean",
      "geography": "area_polygon",
      "direction": "higher_better",
      "methodType": "deterministic",
      "formula": "delivered_supply_day = sum(contribution_source_day) over sources",
      "noDoubleCount": ["reuse", "recharge", "carry_over"],
      "provenance": ["per_source_manifest_entry"],
      "nullSemantics": "provisional with named missing source; missing source is NOT treated as 0",
      "displayRounding": { "type": "decimal_places", "value": 1, "unit": "MLD" },
      "status": "proposed"
    },
    {
      "id": "reliable_supply",
      "name": "Reliable supply (dependable yield)",
      "unit": "MLD",
      "storedUnit": "L/day",
      "valueType": "rate",
      "timeWindow": "reporting_window",
      "geography": "area_polygon",
      "direction": "higher_better",
      "methodType": "deterministic",
      "parameters": { "exceedance_p": 0.9 },
      "formula": "max{ v : P(delivered_supply_day >= v) >= p }",
      "distinctFrom": ["volume_reliability"],
      "provenance": ["delivered_supply_provenance", "exceedance_p"],
      "nullSemantics": "unavailable if series too short/incomplete to estimate exceedance at p",
      "displayRounding": { "type": "decimal_places", "value": 1, "unit": "MLD" },
      "status": "proposed"
    },
    {
      "id": "deficit",
      "name": "Deficit (reliable-supply basis)",
      "unit": "MLD",
      "storedUnit": "L/day",
      "valueType": "rate",
      "timeWindow": "reporting_window",
      "geography": "area_polygon",
      "direction": "lower_better",
      "methodType": "deterministic",
      "formula": "max(0, demand - reliable_supply)",
      "relatedSeries": { "daily_deficit": "max(0, demand_day - delivered_supply_day)" },
      "provenance": ["demand_provenance", "supply_provenance"],
      "nullSemantics": "unavailable if either input unavailable; never 0 by default",
      "displayRounding": { "type": "decimal_places", "value": 1, "unit": "MLD" },
      "status": "proposed"
    },
    {
      "id": "shortage_days",
      "name": "Shortage-day count",
      "unit": "days",
      "valueType": "count",
      "timeWindow": "reporting_window_half_open_local_calendar",
      "geography": "area_polygon",
      "direction": "lower_better",
      "methodType": "deterministic",
      "formula": "count{ day in [start,end) : delivered_supply_day < demand_day }",
      "distinctFrom": ["days_until_shortage"],
      "provenance": ["daily_supply_demand_series"],
      "nullSemantics": "unavailable if series does not cover window",
      "displayRounding": { "type": "integer", "unit": "days" },
      "status": "proposed"
    },
    {
      "id": "days_until_shortage",
      "name": "Days until shortage (lead time)",
      "unit": "days",
      "valueType": "duration",
      "timeWindow": "forward_from_reference_date_bounded_horizon",
      "geography": "area_polygon",
      "direction": "higher_better",
      "methodType": "deterministic",
      "formula": "min{ day - reference_date : day >= reference_date, delivered_supply_day < demand_day }",
      "distinctFrom": ["shortage_days"],
      "provenance": ["forward_daily_series", "reference_date"],
      "nullSemantics": "unavailable if no forward series; '>= horizon' if no shortage in horizon (not 0)",
      "displayRounding": { "type": "integer", "unit": "days" },
      "status": "proposed"
    },
    {
      "id": "volume_reliability",
      "name": "Volume reliability",
      "unit": "ratio",
      "range": [0, 1],
      "valueType": "ratio",
      "timeWindow": "reporting_window",
      "geography": "area_polygon",
      "direction": "higher_better",
      "methodType": "deterministic",
      "formula": "sum(min(delivered_supply_day, demand_day)) / sum(demand_day)",
      "distinctFrom": ["time_reliability"],
      "provenance": ["daily_supply_demand_series"],
      "nullSemantics": "unavailable if demand total is 0 or series incomplete",
      "displayRounding": { "type": "percent_decimal_places", "value": 0, "internalRatioDp": 3 },
      "status": "proposed"
    },
    {
      "id": "time_reliability",
      "name": "Time reliability",
      "unit": "ratio",
      "range": [0, 1],
      "valueType": "ratio",
      "timeWindow": "reporting_window",
      "geography": "area_polygon",
      "direction": "higher_better",
      "methodType": "deterministic",
      "formula": "count{ day : delivered_supply_day >= demand_day } / count{ day in window }",
      "distinctFrom": ["volume_reliability"],
      "provenance": ["daily_supply_demand_series"],
      "nullSemantics": "unavailable if series incomplete",
      "displayRounding": { "type": "percent_decimal_places", "value": 0, "internalRatioDp": 3 },
      "status": "proposed"
    },
    {
      "id": "tanker_dependence",
      "name": "Tanker dependence",
      "unit": "ratio",
      "range": [0, 1],
      "valueType": "ratio",
      "timeWindow": "reporting_window",
      "geography": "area_polygon",
      "direction": "lower_better",
      "methodType": "deterministic",
      "formula": "sum(tanker_contribution_day) / sum(delivered_supply_day)",
      "note": "A share, not a day-count. Screenshot label in 'days' is an inconsistency (see metrics.md C3).",
      "provenance": ["tanker_source_manifest", "total_supply_provenance"],
      "nullSemantics": "unavailable if tanker contribution or total supply unavailable",
      "displayRounding": { "type": "percent_decimal_places", "value": 0, "internalRatioDp": 3 },
      "status": "proposed"
    },
    {
      "id": "project_cost",
      "name": "Project cost (capital)",
      "unit": "INR",
      "storedUnit": "INR_paise",
      "valueType": "money",
      "timeWindow": "point_in_time_cost_basis_date",
      "geography": "plan_area",
      "direction": "lower_better",
      "methodType": "deterministic",
      "formula": "sum(capital_cost_intervention) with per-item source and basis date",
      "note": "O&M tracked as a separate annual series, not folded into capital.",
      "provenance": ["intervention_catalog_entry_per_item"],
      "nullSemantics": "unavailable if any selected intervention lacks a costed basis",
      "displayRounding": { "type": "whole_inr" },
      "status": "proposed"
    },
    {
      "id": "avoided_cost",
      "name": "Avoided cost",
      "unit": "INR",
      "storedUnit": "INR_paise",
      "valueType": "money",
      "timeWindow": "explicit_horizon_with_annual_breakdown",
      "geography": "plan_area",
      "direction": "higher_better",
      "methodType": "requires_reviewed_model",
      "formula": "sum_year(avoided_volume_year * unit_price)",
      "noDoubleCount": ["savings_counted_elsewhere"],
      "provenance": ["engine_run_id_for_avoided_volume", "dated_unit_price_source"],
      "nullSemantics": "unavailable if avoided volume or unit price unverified; label 'illustrative estimate' only when inputs are explicit assumptions",
      "displayRounding": { "type": "whole_inr" },
      "status": "proposed"
    },
    {
      "id": "net_benefit",
      "name": "Net benefit",
      "unit": "INR",
      "storedUnit": "INR_paise",
      "valueType": "money",
      "timeWindow": "economics_horizon",
      "geography": "plan_area",
      "direction": "higher_better",
      "methodType": "deterministic",
      "discounting": "none_by_default_future_reviewed_option",
      "formula": "sum_year(avoided_cost_year + other_benefit_year - om_cost_year) - project_cost",
      "note": "Funding/grants are NOT added here (they change who pays, not economic benefit).",
      "provenance": ["avoided_cost", "project_cost", "om_cost_series"],
      "nullSemantics": "unavailable if any component unavailable",
      "displayRounding": { "type": "whole_inr" },
      "status": "proposed"
    },
    {
      "id": "payback_period",
      "name": "Payback period",
      "unit": "months",
      "valueType": "duration",
      "timeWindow": "economics_horizon",
      "geography": "plan_area",
      "direction": "lower_better",
      "methodType": "deterministic",
      "formula": "first period cumulative_cashflow >= 0; interpolate within year; months = round(years*12)",
      "specialValue": "no_payback if cumulative never reaches 0 within horizon",
      "provenance": ["net_benefit_cashflow_series"],
      "nullSemantics": "unavailable if cash flows unavailable; 'no_payback' (not 0, not large number) if never breaks even",
      "displayRounding": { "type": "integer", "unit": "months" },
      "status": "proposed"
    }
  ]
}
