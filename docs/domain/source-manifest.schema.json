{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waterlens/docs/domain/source-manifest.schema.json",
  "title": "WaterLens Source Manifest",
  "description": "Provenance record for one ingested dataset. Mirrors HLD §11 provenance requirements. Status is PROPOSED pending domain review. A manifest entry does not assert local suitability or licensing rights — those are checked separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "sourceUrl",
    "licence",
    "capability",
    "variables",
    "temporalCoverage",
    "spatialCoverage",
    "observationTimestamp",
    "ingestionTimestamp",
    "qualityStatus",
    "transformationVersion",
    "accessTier"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable manifest id (slug).",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "usageRights"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "usageRights": {
          "type": "string",
          "enum": ["unverified", "non_commercial", "open", "restricted", "prohibited"]
        },
        "attributionText": { "type": "string" }
      }
    },
    "capability": {
      "type": "string",
      "description": "Which capability this source feeds (see capability-matrix.json).",
      "enum": [
        "rainfall",
        "groundwater",
        "surface_water",
        "water_quality",
        "flood_risk",
        "land_cover",
        "utility_supply",
        "shared_aquifer_neighbour"
      ]
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit"],
        "properties": {
          "name": { "type": "string" },
          "unit": {
            "type": "string",
            "description": "Canonical unit per conventions.md",
            "enum": [
              "L",
              "L/day",
              "MLD",
              "m3",
              "m3/day",
              "mm",
              "m_bgl",
              "ratio",
              "percent",
              "m2",
              "km2",
              "INR_paise",
              "count",
              "category"
            ]
          },
          "bandOrField": { "type": "string" },
          "scaleMeters": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Native spatial scale/resolution in metres, where applicable."
          }
        }
      }
    },
    "temporalCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "endExclusive", "boundary"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date",
          "description": "Inclusive local calendar start."
        },
        "endExclusive": {
          "type": "string",
          "format": "date",
          "description": "Exclusive local calendar end (half-open [start,endExclusive))."
        },
        "boundary": { "type": "string", "const": "half_open_start_inclusive_end_exclusive" },
        "timezone": {
          "type": "string",
          "description": "IANA tz for local-date semantics, e.g. Asia/Kolkata."
        }
      }
    },
    "spatialCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "crs"],
      "properties": {
        "type": { "type": "string", "enum": ["bbox", "geojson_ref", "admin_area"] },
        "crs": { "type": "string", "description": "e.g. EPSG:4326", "default": "EPSG:4326" },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[minLon, minLat, maxLon, maxLat] when type=bbox."
        },
        "geojsonObjectRef": {
          "type": "string",
          "description": "Object-storage key for large geometry (not inlined)."
        },
        "adminAreaId": { "type": "string" }
      }
    },
    "observationTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant the data represents / was observed (ISO-8601 Z)."
    },
    "ingestionTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant of ingestion (ISO-8601 Z)."
    },
    "qualityStatus": {
      "type": "string",
      "enum": ["proposed", "validated", "provisional", "quarantined", "unavailable", "synthetic"],
      "description": "See conventions.md §5. 'synthetic' must never be presented as live evidence."
    },
    "qualityFlags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "e.g. coverage_gap, unit_mismatch, stale, unverified_licence."
    },
    "transformationVersion": {
      "type": "string",
      "description": "Version of the normalization/transformation pipeline applied."
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algo", "value"],
      "properties": {
        "algo": { "type": "string", "enum": ["sha256"] },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "description": "Checksum of the immutable raw object."
    },
    "rawObjectRef": {
      "type": "string",
      "description": "Object-storage key of the immutable raw import."
    },
    "accessTier": {
      "type": "string",
      "enum": ["public_global", "licensed", "local_measured", "restricted"],
      "description": "Governs storage location and tenant visibility."
    },
    "eligibilityNotes": {
      "type": "string",
      "description": "Registration/eligibility prerequisites (e.g. Earth Engine noncommercial), checked separately."
    },
    "requiresLocalMeasurement": {
      "type": "boolean",
      "description": "True if the fed capability cannot be inferred from imagery alone."
    },
    "supersedes": { "type": "string", "description": "Manifest id this entry replaces, if any." }
  }
}
