{
  "openapi": "3.1.0",
  "info": {
    "title": "WaterLens API",
    "description": "WaterLens backend API. /v1 tenant routes are added in later phases.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthStatus"
      },
      "ReadyStatus": {
        "properties": {
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "app_mode": {
            "type": "string",
            "title": "App Mode"
          },
          "using_emulators": {
            "type": "boolean",
            "title": "Using Emulators"
          }
        },
        "type": "object",
        "required": [
          "ready",
          "app_mode",
          "using_emulators"
        ],
        "title": "ReadyStatus"
      }
    }
  }
}
