# WaterPilot backend configuration (placeholders only — no real secrets here).
# Copy to .env for local development.

# local | pilot. Local mode REQUIRES emulators and never touches real cloud.
WP_APP_MODE=local

# Local mode must use emulators (fail-closed otherwise).
WP_USE_EMULATORS=true

# Emulator hosts as host:port. Required in local mode (loopback only), must be UNSET in
# pilot mode. The standard FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST are also
# read and validated; if both forms are set they must agree.
WP_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
WP_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional: exact non-loopback emulator hostnames allowed in local mode (JSON array),
# e.g. a container service name. Must be empty in pilot mode.
# WP_EMULATOR_EXTRA_HOSTNAMES=["firebase-emulators"]

# Local mode requires exactly demo-waterpilot. Pilot mode requires a real (non demo-*) project.
WP_GCP_PROJECT=demo-waterpilot

# Local application store: firestore (default; the Firestore emulator above) or memory
# (in-process, lost on restart; for quick experiments). Both use synthetic catalogues.
WP_LOCAL_STORE=firestore

# Local filesystem object storage + job queue directories (never committed; local mode only).
# The file queue is a single-process development stand-in, not production durability
# (ADR 0007): run one `npm run dev:worker` beside `npm run dev:api` with the Firestore store.
WP_OBJECT_STORAGE_DIR=.local-object-store
WP_JOB_QUEUE_DIR=.local-jobs
# WP_LOCAL_WORKER_POLL_SECONDS=1
# WP_LOCAL_WORKER_RECONCILE_SECONDS=30

# Cloud durable jobs and artifacts (pilot only; must be UNSET in local mode). Resource
# names and service-account emails, not secrets. Example shapes:
# WP_ARTIFACT_BUCKET=<project>-waterpilot-artifacts
# WP_TASKS_QUEUE=projects/<project>/locations/<region>/queues/waterpilot-jobs
# WP_WORKER_URL=https://<worker-service>.run.app
# WP_TASKS_SERVICE_ACCOUNT=waterpilot-dispatch@<project>.iam.gserviceaccount.com
# WP_WORKER_INVOKERS=["waterpilot-dispatch@<project>.iam.gserviceaccount.com"]

# Exact allowed browser origins for CORS (JSON array). Pilot mode requires https,
# non-loopback origins; the localhost defaults are rejected there.
WP_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ID tokens (ADR 0004): local mode verifies unsigned Auth-emulator tokens for the demo
# project and checks each account in the emulator. Pilot mode verifies with the Firebase
# Admin SDK (signature + revocation) using Application Default Credentials; it refuses to
# start if FIREBASE_AUTH_EMULATOR_HOST is set.

# NOTE: Service-account keys / Vertex credentials are NEVER placed here or in code.
# Cloud auth uses Application Default Credentials / runtime service identities.

# Guest-to-account claim windows (ADR 0004). Defaults: 10-minute claims, sign-in within
# 5 minutes. Out-of-range values (60–3600 / 60–900 seconds) stop start-up.
# WP_ACCOUNT_CLAIM_TTL_SECONDS=600
# WP_ACCOUNT_CLAIM_FRESH_SIGN_IN_SECONDS=300

# Server-side place search (ADR 0009). Pilot only: local mode refuses it and uses the
# fixture gazetteer. A secret: restrict it to Places API (New) and keep it in Secret
# Manager. Unset in pilot = the API reports search unavailable; the browser key still works.
# WP_PLACES_SERVER_KEY=

# Server-only Gemini on Vertex AI and usage controls (ADR 0015). ALL default OFF; AI is a
# deliberate owner setup, not permission to spend. The live Vertex adapter is built ONLY in
# pilot mode with WP_AI_ENABLED=true, the kill switch off and a budget set; local/test mode
# always uses the disabled or fake provider, so no local run can make a billable call.
# Credentials use Application Default Credentials for a DEDICATED runtime service account
# with roles/aiplatform.user — never a user credential, never an API key, never here.
# WP_AI_ENABLED=false
# WP_AI_KILL_SWITCH=false            # global server kill switch (overrides everything)
# WP_AI_OPEN_TO_ALL=false            # if false, only invited testers may use AI
# WP_AI_INVITED_TESTERS=["uid-1"]    # JSON array of allowed uids (hackathon invites)
# WP_AI_MODEL=gemini-2.5-flash       # must be in domain/ai.py MODEL_CATALOGUE
# WP_AI_LOCATION=global
# WP_AI_DAILY_BUDGET_USD=5           # SUGGESTED allowance; UNSET => AI reports NO_BUDGET_CONFIGURED (off)
# WP_AI_DAILY_REQUEST_LIMIT=100
# WP_AI_MAX_CALLS_PER_RUN=5          # calls per run before a user-visible Continue checkpoint
# WP_AI_TRANSIENT_RETRIES=2
# WP_AI_REQUEST_TIMEOUT_SECONDS=30
# WP_AI_RESERVATION_TTL_SECONDS=300
# WP_AI_MAX_INPUT_TOKENS=48000
# WP_AI_MAX_OUTPUT_TOKENS=1024

# Gated live Vertex smoke (tests/live/test_vertex_ai_live.py, `-m live`). NOT run by default
# and never in CI. Requires a real project with Vertex AI enabled + billing, ADC for the
# runtime service account, and the chosen model enabled for the project. Opt in per run:
# WP_LIVE_VERTEX_PROJECT=<real-project-id>
# WP_LIVE_VERTEX_LOCATION=global
# WP_LIVE_VERTEX_MODEL=gemini-2.5-flash

# Prompt 17 local conversation (fake inference only; rejected in pilot).
# Opt in together with WP_AI_ENABLED, allowance and invited/open-to-all settings above.
# WP_AGENT_FAKE_INFERENCE=false

# Location-informed illustrative previews (no ADK required; defaults OFF).
# Local: opt in to the fake provider only; no Google credentials are needed or used.
# Pilot: keep FAKE=false; the existing Vertex provider uses dedicated runtime ADC,
# WL_GCP_PROJECT, WL_AI_LOCATION, WL_AI_MODEL and the AI budget/tester controls above.
# WL_AREA_ASSUMPTIONS_ENABLED=false
# WL_AREA_ASSUMPTIONS_FAKE=false

# Trusted permanent Firebase UIDs allowed to curate funding; empty denies everyone.
# Emulator/local accounts only for Prompts 18–25. Never a browser-provided role.
WP_FUNDING_ADMIN_UIDS=[]

# Prompt 19: local fake relevance only; AI budget/invitation/kill switch still apply.
WP_FUNDING_FAKE_EMBEDDINGS=false

# Local browser Maps only; accepts Google place IDs, never enables server API calls.
WP_LOCAL_GOOGLE_MAPS_ENABLED=false
