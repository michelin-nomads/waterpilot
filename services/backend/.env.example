# WaterLens backend configuration (placeholders only — no real secrets here).
# Copy to .env for local development.

# local | pilot. Local mode REQUIRES emulators and never touches real cloud.
WL_APP_MODE=local

# Local mode must use emulators (fail-closed otherwise).
WL_USE_EMULATORS=true

# Emulator hosts as host:port. Required in local mode (loopback only), must be UNSET in
# pilot mode. The standard FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST are also
# read and validated; if both forms are set they must agree.
WL_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
WL_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional: exact non-loopback emulator hostnames allowed in local mode (JSON array),
# e.g. a container service name. Must be empty in pilot mode.
# WL_EMULATOR_EXTRA_HOSTNAMES=["firebase-emulators"]

# Local mode requires exactly demo-waterlens. Pilot mode requires a real (non demo-*) project.
WL_GCP_PROJECT=demo-waterlens

# Local application store: firestore (default; the Firestore emulator above) or memory
# (in-process, lost on restart; for quick experiments). Both use synthetic catalogues.
WL_LOCAL_STORE=firestore

# Local filesystem object storage + job queue directories (never committed; local mode only).
# The file queue is a single-process development stand-in, not production durability
# (ADR 0007): run one `npm run dev:worker` beside `npm run dev:api` with the Firestore store.
WL_OBJECT_STORAGE_DIR=.local-object-store
WL_JOB_QUEUE_DIR=.local-jobs
# WL_LOCAL_WORKER_POLL_SECONDS=1
# WL_LOCAL_WORKER_RECONCILE_SECONDS=30

# Cloud durable jobs and artifacts (pilot only; must be UNSET in local mode). Resource
# names and service-account emails, not secrets. Example shapes:
# WL_ARTIFACT_BUCKET=<project>-waterlens-artifacts
# WL_TASKS_QUEUE=projects/<project>/locations/<region>/queues/waterlens-jobs
# WL_WORKER_URL=https://<worker-service>.run.app
# WL_TASKS_SERVICE_ACCOUNT=waterlens-dispatch@<project>.iam.gserviceaccount.com
# WL_WORKER_INVOKERS=["waterlens-dispatch@<project>.iam.gserviceaccount.com"]

# Exact allowed browser origins for CORS (JSON array). Pilot mode requires https,
# non-loopback origins; the localhost defaults are rejected there.
WL_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ID tokens (ADR 0004): local mode verifies unsigned Auth-emulator tokens for the demo
# project and checks each account in the emulator. Pilot mode verifies with the Firebase
# Admin SDK (signature + revocation) using Application Default Credentials; it refuses to
# start if FIREBASE_AUTH_EMULATOR_HOST is set.

# NOTE: Service-account keys / Vertex credentials are NEVER placed here or in code.
# Cloud auth uses Application Default Credentials / runtime service identities.

# Guest-to-account claim windows (ADR 0004). Defaults: 10-minute claims, sign-in within
# 5 minutes. Out-of-range values (60–3600 / 60–900 seconds) stop start-up.
# WL_ACCOUNT_CLAIM_TTL_SECONDS=600
# WL_ACCOUNT_CLAIM_FRESH_SIGN_IN_SECONDS=300

# Server-side place search (ADR 0009). Pilot only: local mode refuses it and uses the
# fixture gazetteer. A secret: restrict it to Places API (New) and keep it in Secret
# Manager. Unset in pilot = the API reports search unavailable; the browser key still works.
# WL_PLACES_SERVER_KEY=
